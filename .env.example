# =========================================================================
# SentinelGraph Environment Variable Configurations Template
# Copy this file to '.env' inside this directory and customize parameters.
# =========================================================================

# --- SRE COPILOT REASONING PROVIDER ---
# Configures the active agent LLM model client.
# Options: 
#   - 'fallback': Uses highly realistic, zero-setup stubs (Recommended for rapid initial runs).
#   - 'ollama': Connects to a local running Ollama instance on your machine.
#   - 'openai': Connects to standard OpenAI models (Requires OPENAI_API_KEY).
LLM_PROVIDER=fallback

# --- LOCAL OLLAMA SERVER SETTINGS (Only required if LLM_PROVIDER=ollama) ---
# Ensure your Ollama server is running (e.g. `ollama run mistral`)
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# --- API KEY SETTINGS (Only required if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- DATABASE STORAGE CONFIGURATIONS ---
# SQLite handles local structured storage natively.
DATABASE_URL=sqlite:///./sentinelgraph.db

# --- TELEMETRY OBSERVABILITY SETTINGS (Phase 3 & 4 integration) ---
# Exposes SRE operations tracing dashboards.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://localhost:3000
